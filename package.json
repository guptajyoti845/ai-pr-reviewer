{
  "name": "ai-pr-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub App that reviews pull requests with an OpenAI-compatible model.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "probot run ./src/index.ts",
    "start": "probot run ./dist/index.js",
    "review": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "probot": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
